-- VERIFICACIÓN: RECONSTRUCCIÓN DE LA PLANILLA ORIGINAL


SELECT
    o.ID_ORDEN,
    o.FECHA,
    c.RUT_CLIENTE,
    c.NOM_CLIENTE,
    c.FONO_CLIENTE,
    v.PATENTE_AUTO,
    v.MARCA_AUTO,
    r.ID_REPUESTO,
    r.NOM_REPUESTO,
    r.PRECIO_UNITARIO,
    d.CANTIDAD,
    (r.PRECIO_UNITARIO * d.CANTIDAD) AS SUBTOTAL,
    m.MECANICO_RUT,
    m.MECANICO_NOM
FROM        ORDEN          o
INNER JOIN  CLIENTE        c ON o.RUT_CLIENTE   = c.RUT_CLIENTE
INNER JOIN  VEHICULO       v ON o.PATENTE_AUTO  = v.PATENTE_AUTO
INNER JOIN  MECANICO       m ON o.MECANICO_RUT  = m.MECANICO_RUT
INNER JOIN  DETALLE_ORDEN  d ON o.ID_ORDEN      = d.ID_ORDEN
INNER JOIN  REPUESTO       r ON d.ID_REPUESTO   = r.ID_REPUESTO
ORDER BY    o.ID_ORDEN, r.ID_REPUESTO;


