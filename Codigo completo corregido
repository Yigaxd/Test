-- ============================================================
-- PARTE 4: CONSULTAS Y OBJETOS
-- ============================================================

USE serviexpress_db;

-- 4.1 Consulta de reconstrucción con INNER JOIN y campo calculado TOTAL_LINEA
SELECT
    o.ID_ORDEN,
    o.FECHA,
    c.RUT_CLIENTE,
    c.NOM_CLIENTE,
    c.FONO_CLIENTE,
    v.PATENTE_AUTO,
    v.MARCA_AUTO,
    r.ID_REPUESTO,
    r.NOM_REPUESTO,
    r.PRECIO_UNITARIO,
    d.CANTIDAD,
    (r.PRECIO_UNITARIO * d.CANTIDAD) AS TOTAL_LINEA,
    m.MECANICO_RUT,
    m.MECANICO_NOM
FROM           ORDEN          o
    INNER JOIN CLIENTE        c ON o.RUT_CLIENTE  = c.RUT_CLIENTE
    INNER JOIN VEHICULO       v ON o.PATENTE_AUTO = v.PATENTE_AUTO
    INNER JOIN MECANICO       m ON o.MECANICO_RUT = m.MECANICO_RUT
    INNER JOIN DETALLE_ORDEN  d ON o.ID_ORDEN     = d.ID_ORDEN
    INNER JOIN REPUESTO       r ON d.ID_REPUESTO  = r.ID_REPUESTO
ORDER BY o.ID_ORDEN ASC;


-- 4.2 Vista que encapsula la consulta anterior
CREATE VIEW vista_resumen_servicios AS
SELECT
    o.ID_ORDEN,
    o.FECHA,
    c.RUT_CLIENTE,
    c.NOM_CLIENTE,
    c.FONO_CLIENTE,
    v.PATENTE_AUTO,
    v.MARCA_AUTO,
    r.ID_REPUESTO,
    r.NOM_REPUESTO,
    r.PRECIO_UNITARIO,
    d.CANTIDAD,
    (r.PRECIO_UNITARIO * d.CANTIDAD) AS TOTAL_LINEA,
    m.MECANICO_RUT,
    m.MECANICO_NOM
FROM           ORDEN          o
    INNER JOIN CLIENTE        c ON o.RUT_CLIENTE  = c.RUT_CLIENTE
    INNER JOIN VEHICULO       v ON o.PATENTE_AUTO = v.PATENTE_AUTO
    INNER JOIN MECANICO       m ON o.MECANICO_RUT = m.MECANICO_RUT
    INNER JOIN DETALLE_ORDEN  d ON o.ID_ORDEN     = d.ID_ORDEN
    INNER JOIN REPUESTO       r ON d.ID_REPUESTO  = r.ID_REPUESTO
ORDER BY o.ID_ORDEN ASC;

-- Verificación de la vista
SELECT * FROM vista_resumen_servicios;


-- 4.3 Procedimiento almacenado: devuelve los trabajos de un mecánico por su RUT
DELIMITER $$

CREATE PROCEDURE sp_obtener_servicios_mecanico (
    IN p_mecanico_rut VARCHAR(15)
)
BEGIN
    SELECT
        ID_ORDEN,
        FECHA,
        RUT_CLIENTE,
        NOM_CLIENTE,
        FONO_CLIENTE,
        PATENTE_AUTO,
        MARCA_AUTO,
        ID_REPUESTO,
        NOM_REPUESTO,
        PRECIO_UNITARIO,
        CANTIDAD,
        TOTAL_LINEA,
        MECANICO_RUT,
        MECANICO_NOM
    FROM  vista_resumen_servicios
    WHERE MECANICO_RUT = p_mecanico_rut
    ORDER BY ID_ORDEN ASC;
END$$

DELIMITER ;

-- Llamadas de prueba al procedimiento
CALL sp_obtener_servicios_mecanico('10.888.777-6'); -- Juan Gomez: órdenes 5001 y 5003
CALL sp_obtener_servicios_mecanico('12.555.444-K'); -- Raul Soto:  orden 5002
