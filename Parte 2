-- SCRIPT DDL FÍSICO: serviexpress_db
--
-- ESQUEMA RELACIONAL LÓGICO (referencia):
--   CLIENTE       ( RUT_CLIENTE [PK], NOM_CLIENTE, FONO_CLIENTE )
--   VEHICULO      ( PATENTE_AUTO [PK], MARCA_AUTO,
--                   RUT_CLIENTE [FK -> CLIENTE.RUT_CLIENTE] )
--   MECANICO      ( MECANICO_RUT [PK], MECANICO_NOM )
--   REPUESTO      ( ID_REPUESTO [PK], NOM_REPUESTO, PRECIO_UNITARIO )
--   ORDEN         ( ID_ORDEN [PK], FECHA,
--                   RUT_CLIENTE   [FK -> CLIENTE.RUT_CLIENTE],
--                   PATENTE_AUTO  [FK -> VEHICULO.PATENTE_AUTO],
--                   MECANICO_RUT  [FK -> MECANICO.MECANICO_RUT] )
--   DETALLE_ORDEN ( ID_ORDEN    [PK, FK -> ORDEN.ID_ORDEN],
--                   ID_REPUESTO [PK, FK -> REPUESTO.ID_REPUESTO],
--                   CANTIDAD )
--
CREATE DATABASE serviexpress_db
    CHARACTER SET utf8mb4
    COLLATE utf8mb4_spanish_ci;

-- Selecciona la base de datos para todas las sentencias siguientes
USE serviexpress_db;


CREATE TABLE CLIENTE (
    RUT_CLIENTE   VARCHAR(15)   NOT NULL
        COMMENT 'RUT con dígito verificador, formato: 12.345.678-9',
    NOM_CLIENTE   VARCHAR(100)  NOT NULL
        COMMENT 'Nombre completo del cliente',
    FONO_CLIENTE  VARCHAR(20)   NULL
        COMMENT 'Teléfono de contacto en formato internacional, ej: 56911112222',

    CONSTRAINT PK_CLIENTE PRIMARY KEY (RUT_CLIENTE)
)
ENGINE = InnoDB
COMMENT = 'Clientes registrados en el sistema ServiExpress';


CREATE TABLE MECANICO (
    MECANICO_RUT  VARCHAR(15)   NOT NULL
        COMMENT 'RUT del mecánico con dígito verificador',
    MECANICO_NOM  VARCHAR(100)  NOT NULL
        COMMENT 'Nombre completo del mecánico',

    CONSTRAINT PK_MECANICO PRIMARY KEY (MECANICO_RUT)
)
ENGINE = InnoDB
COMMENT = 'Mecánicos del taller ServiExpress';


CREATE TABLE REPUESTO (
    ID_REPUESTO      VARCHAR(10)    NOT NULL
        COMMENT 'Código interno del repuesto, ej: R01',
    NOM_REPUESTO     VARCHAR(100)   NOT NULL
        COMMENT 'Nombre descriptivo del repuesto',
    PRECIO_UNITARIO  DECIMAL(10,2)  NOT NULL
        COMMENT 'Precio unitario en pesos chilenos (CLP), exacto a 2 decimales',

    CONSTRAINT PK_REPUESTO PRIMARY KEY (ID_REPUESTO),
    CONSTRAINT CHK_PRECIO_POSITIVO
        CHECK (PRECIO_UNITARIO > 0)
)
ENGINE = InnoDB
COMMENT = 'Catálogo de repuestos con precios exactos en DECIMAL(10,2)';


CREATE TABLE VEHICULO (
    PATENTE_AUTO  VARCHAR(8)    NOT NULL
        COMMENT 'Patente sin guiones ni espacios, máximo 8 caracteres, ej: DLPP40',
    MARCA_AUTO    VARCHAR(50)   NOT NULL
        COMMENT 'Marca del vehículo, ej: Toyota, Hyundai',
    RUT_CLIENTE   VARCHAR(15)   NOT NULL
        COMMENT 'RUT del propietario del vehículo (FK a CLIENTE)',

    CONSTRAINT PK_VEHICULO PRIMARY KEY (PATENTE_AUTO),
    CONSTRAINT FK_VEHICULO_CLIENTE
        FOREIGN KEY (RUT_CLIENTE)
        REFERENCES CLIENTE (RUT_CLIENTE)
        ON UPDATE CASCADE
        ON DELETE RESTRICT
)
ENGINE = InnoDB
COMMENT = 'Vehículos registrados; patente en VARCHAR(8) sin guiones';


CREATE TABLE ORDEN (
    ID_ORDEN      INT            NOT NULL
        COMMENT 'Identificador único de la orden de servicio',
    FECHA         DATE           NOT NULL
        COMMENT 'Fecha de emisión de la orden (formato YYYY-MM-DD)',
    RUT_CLIENTE   VARCHAR(15)    NOT NULL
        COMMENT 'Cliente que solicita el servicio (FK a CLIENTE)',
    PATENTE_AUTO  VARCHAR(8)     NOT NULL
        COMMENT 'Vehículo ingresado al taller (FK a VEHICULO)',
    MECANICO_RUT  VARCHAR(15)    NOT NULL
        COMMENT 'Mecánico responsable de la orden (FK a MECANICO)',

    CONSTRAINT PK_ORDEN PRIMARY KEY (ID_ORDEN),

    CONSTRAINT FK_ORDEN_CLIENTE
        FOREIGN KEY (RUT_CLIENTE)
        REFERENCES CLIENTE (RUT_CLIENTE)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT FK_ORDEN_VEHICULO
        FOREIGN KEY (PATENTE_AUTO)
        REFERENCES VEHICULO (PATENTE_AUTO)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT FK_ORDEN_MECANICO
        FOREIGN KEY (MECANICO_RUT)
        REFERENCES MECANICO (MECANICO_RUT)
        ON UPDATE CASCADE
        ON DELETE RESTRICT
)
ENGINE = InnoDB
COMMENT = 'Encabezado de órdenes de servicio ServiExpress';



CREATE TABLE DETALLE_ORDEN (
    ID_ORDEN     INT            NOT NULL
        COMMENT 'Orden a la que pertenece el detalle (FK a ORDEN)',
    ID_REPUESTO  VARCHAR(10)    NOT NULL
        COMMENT 'Repuesto utilizado en la orden (FK a REPUESTO)',
    CANTIDAD     INT            NOT NULL
        COMMENT 'Unidades del repuesto utilizadas; mínimo 1',

    CONSTRAINT PK_DETALLE_ORDEN PRIMARY KEY (ID_ORDEN, ID_REPUESTO),

    CONSTRAINT FK_DETALLE_ORDEN
        FOREIGN KEY (ID_ORDEN)
        REFERENCES ORDEN (ID_ORDEN)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT FK_DETALLE_REPUESTO
        FOREIGN KEY (ID_REPUESTO)
        REFERENCES REPUESTO (ID_REPUESTO)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,

    CONSTRAINT CHK_CANTIDAD_MINIMA
        CHECK (CANTIDAD >= 1)
)
ENGINE = InnoDB
COMMENT = 'Detalle de repuestos por orden; PK compuesta (ID_ORDEN, ID_REPUESTO)';


DESCRIBE CLIENTE;
DESCRIBE MECANICO;
DESCRIBE REPUESTO;
DESCRIBE VEHICULO;
DESCRIBE ORDEN;
DESCRIBE DETALLE_ORDEN;
